{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tahan.local/schemas/plugin-manifest.schema.json",
  "title": "Plugin Manifest",
  "description": "اسکیمای مانیفست پلاگین کرنل آریا — نسخه اولیه فاز ۰",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "api_version",
    "entrypoint",
    "runtime_mode",
    "kernel_version_range",
    "api_version_range"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "شناسه یکتای پلاگین"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "نام نمایشی پلاگین"
    },
    "version": {
      "type": "string",
      "description": "نسخه معنایی پلاگین (semver)"
    },
    "api_version": {
      "type": "string",
      "description": "نسخه API پلاگین"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "description": "مسیر نقطه ورود پلاگین"
    },
    "runtime_mode": {
      "enum": ["out_of_process", "in_process_trusted"],
      "description": "حالت اجرا؛ پلاگین‌های قابل نصب پیش‌فرض out_of_process هستند"
    },
    "kernel_version_range": {
      "type": "string",
      "description": "محدوده نسخه کرنل سازگار (semver range)"
    },
    "api_version_range": {
      "type": "string",
      "description": "محدوده نسخه API سازگار (semver range)"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "فهرست قابلیت‌های مورد نیاز"
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "فهرست مجوزهای مورد نیاز"
    },
    "resources": {
      "type": "object",
      "properties": {
        "max_memory_mb": { "type": "integer", "minimum": 1 },
        "max_cpu_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "description": "محدوده منابع پلاگین"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "شناسه پلاگین‌های وابسته"
    },
    "locales": {
      "type": "array",
      "items": { "type": "string" },
      "description": "زبان‌های پشتیبانی‌شده"
    },
    "ui_extension_points": {
      "type": "array",
      "items": { "type": "string" },
      "description": "نقاط افزونه UI اعلانی"
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "trust_level": {
      "enum": ["official", "certified", "community"],
      "description": "سطح اعتماد پلاگین"
    },
    "health_policy": {
      "type": "object",
      "description": "سیاست سلامت پلاگین"
    }
  },
  "additionalProperties": false
}
