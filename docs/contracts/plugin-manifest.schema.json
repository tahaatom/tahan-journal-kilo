{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tahan.local/schemas/plugin-manifest.schema.json",
  "title": "Plugin Manifest",
  "description": "اسکیمای مانیفست پلاگین کرنل آریا — قرارداد نسخه ۱.۰.۰ (تثبیت‌شده در فاز ۱.۲)",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "api_version",
    "entrypoint",
    "runtime_mode",
    "kernel_version_range",
    "api_version_range"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 64,
      "description": "شناسه یکتای پلاگین (حروف کوچک لاتین، اعداد و خط تیره)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "نام نمایشی پلاگین"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "نسخه معنایی پلاگین (semver)"
    },
    "api_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "نسخه API پلاگین (semver)"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "description": "مسیر نقطه ورود پلاگین"
    },
    "runtime_mode": {
      "enum": ["out_of_process", "in_process_trusted"],
      "description": "حالت اجرا؛ پلاگین‌های قابل نصب پیش‌فرض out_of_process هستند و اجرای درون‌فرایندی فقط برای ماژول‌های داخلی قابل اعتماد مجاز است"
    },
    "kernel_version_range": {
      "type": "string",
      "minLength": 1,
      "description": "محدوده نسخه کرنل سازگار (semver range)"
    },
    "api_version_range": {
      "type": "string",
      "minLength": 1,
      "description": "محدوده نسخه API سازگار (semver range)"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "trades.read",
          "trades.write",
          "trades.delete",
          "fields.read",
          "fields.define",
          "attachments.read",
          "attachments.write",
          "stats.read",
          "ui.widget",
          "ui.page",
          "notifications.show",
          "backup.create",
          "backup.restore",
          "mt.import",
          "mt.live",
          "insights.write",
          "network.access"
        ]
      },
      "uniqueItems": true,
      "description": "قابلیت‌های مورد نیاز پلاگین (فهرست نسخه ۱ بسته است)"
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "مجوزهای اعطایی؛ در نسخه ۱ همان واژگان قابلیت‌ها هستند و مجوزهای دامنه‌دار برای نسخه‌های بعدی رزرو شده"
    },
    "resources": {
      "type": "object",
      "properties": {
        "max_memory_mb": { "type": "integer", "minimum": 1 },
        "max_cpu_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false,
      "description": "محدوده منابع پلاگین"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true,
      "description": "شناسه پلاگین‌های وابسته"
    },
    "locales": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
      "uniqueItems": true,
      "description": "زبان‌های پشتیبانی‌شده (BCP-47 ساده)"
    },
    "ui_extension_points": {
      "type": "array",
      "items": {
        "enum": [
          "dashboard_widget",
          "report_page",
          "command_menu",
          "form_field",
          "plugin_settings"
        ]
      },
      "uniqueItems": true,
      "description": "نقاط افزونه UI اعلانی (فهرست نسخه ۱ بسته است)"
    },
    "description": { "type": "string", "description": "توضیحات پلاگین" },
    "author": { "type": "string", "description": "نویسنده پلاگین" },
    "license": { "type": "string", "description": "مجوز پلاگین" },
    "trust_level": {
      "enum": ["official", "certified", "community"],
      "description": "سطح اعتماد پلاگین"
    },
    "health_policy": {
      "type": "object",
      "properties": {
        "max_crashes_before_quarantine": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "تعداد دفعات خرابی پیش از قرنطینه (پیش‌فرض: ۳)"
        }
      },
      "additionalProperties": false,
      "description": "سیاست سلامت پلاگین"
    }
  },
  "additionalProperties": false
}
